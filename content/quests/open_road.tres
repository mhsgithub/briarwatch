[resource]
script = ExtResource("1")
id = &"crowbanes_key"
title = "The Crow's Captive"
description = "Bandit gangs pillage Briarwatch and the kingdom's roads. Only Lord Kasparov can muster the armies to drive them out, but the lord himself has vanished into their hands. Scouts have traced him to the locked cellars beneath the ruins of Warwick Castle.\n\nTheir commander, Darius Crowbane, keeps the cellar key in the captured watchtower northeast of Briarwatch. Enter the tower, defeat Crowbane and retrieve his key. Bring it to Warden Elric so the rescue can begin."
target_encounter = &"crowbane"
target_region = &"watchtower"
required_item = &"cellar_key"
objective = "Enter the northeast watchtower. Retrieve Darius Crowbane's cellar key."
completion_text = "The key is safe with Elric. Kasparov's rescue awaits."
reward_gold = 50
next_quest = ExtResource("next")
