[ext_resource type="Script" path="res://src/data/npc_definition.gd" id="1"]


[resource]
script = ExtResource("1")
id = &"elric"
display_name = "Warden Elric"
title = "Keeper of the road"
service = "warden"
greeting = "Every road brings another family fleeing the gangs. We need Lord Kasparov's armies, but our scouts found him a prisoner beneath Warwick Castle. Crowbane holds the key. We cannot leave our lord to rot."
tint = Color(0.35, 0.49, 0.57, 1)
