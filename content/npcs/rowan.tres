tint = Color(0.34, 0.43, 0.36, 1)
stock = Array[ExtResource("item")]([ExtResource("tonic"), ExtResource("greater_tonic"), ExtResource("guardian_amulet"), ExtResource("wyrmhide_grips"), ExtResource("emerald_band"), ExtResource("wyrmsteel_shoulders"), ExtResource("oakheart_guard"), ExtResource("wyrmfang")])
